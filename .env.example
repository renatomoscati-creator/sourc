# ── AI provider (required for AI briefs + email polishing) ─────────────────
# Provider-agnostic: any OpenAI-compatible chat-completions endpoint works.
# Pick ONE provider, set all three values.
#
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   DeepSeek    AI_BASE_URL=https://api.deepseek.com/v1      AI_MODEL=deepseek-chat
#   Ollama      AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1   (any key)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Firecrawl (optional: only for the /sources Firecrawl import) ────────────
# Get a key at https://firecrawl.dev — leave blank to disable that import path.
FIRECRAWL_API_KEY=
